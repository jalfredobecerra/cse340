<%- include('partials/header') %>

    <% if (!project) { %>
        <h1>Project Not Found</h1>
        <p class="page-intro">We couldn't find a service project with that ID.</p>
        <p><a href="/projects">&larr; Back to upcoming projects</a></p>
        <% } else { %>
            <h1>
                <%= project.title %>
            </h1>

            <p class="page-intro">
                <%= project.description %>
            </p>

            <ul class="panel-list">
                <li class="panel-list__item">
                    <strong>Date</strong>
                    <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                        day: 'numeric' }) %>
                </li>
                <li class="panel-list__item">
                    <strong>Location</strong>
                    <%= project.location %>
                </li>
                <li class="panel-list__item">
                    <strong>Organization</strong>
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </li>
            </ul>

            <% if (categories.length> 0) { %>
                <h2>Categories</h2>
                <ul class="tag-list">
                    <% categories.forEach(category=> { %>
                        <li><a class="tag" href="/category/<%= category.category_id %>">
                                <%= category.name %>
                            </a></li>
                        <% }); %>
                </ul>
                <% } %>

                    <% if (isLoggedIn) { %>
                        <% if (isVolunteering) { %>
                            <p class="page-intro" style="margin-top: var(--space-5);">You are volunteering for this
                                project.</p>
                            <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                                <button type="submit" class="button">Remove Myself as Volunteer</button>
                            </form>
                            <% } else { %>
                                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                                    <button type="submit" class="button">Volunteer for This Project</button>
                                </form>
                                <% } %>
                                    <% } %>

                                        <% if (user && user.role_name==='admin' ) { %>
                                            <a href="/edit-project/<%= project.project_id %>" class="button">Edit
                                                Project</a>
                                            <a href="/assign-categories/<%= project.project_id %>" class="button">Edit
                                                Categories</a>
                                            <% } %>
                                                <% } %>

<%- include('partials/footer') %>