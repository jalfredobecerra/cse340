<%- include('partials/header') %>

    <h1>
        <%= title %>
    </h1>

    <div class="panel-list">
        <div class="panel-list__item">
            <strong>Name</strong>
            <%= name %>
        </div>
        <div class="panel-list__item">
            <strong>Email</strong>
            <%= email %>
        </div>
    </div>

    <% if (user && user.role_name==='admin' ) { %>
        <a href="/users" class="button">View All Users</a>
        <% } %>

<%- include('partials/footer') %>