<%- include('partials/header') %>

    <h1>
        <%= title %>
    </h1>
    <p class="page-intro">Update the name of this category.</p>

    <form class="form" action="/edit-category/<%= category.category_id %>" method="POST">
        <div class="form-group">
            <label for="name">Category Name</label>
            <input type="text" id="name" name="name" value="<%= category.name %>" required maxlength="100">
        </div>

        <button type="submit" class="button">Update Category</button>
    </form>

<%- include('partials/footer') %>