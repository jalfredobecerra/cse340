<%- include('partials/header') %>

    <% if (!organizationDetails) { %>
        <h1>Organization Not Found</h1>
        <p class="page-intro">We couldn't find an organization with that ID. It may have been removed.</p>
        <p><a href="/organizations">&larr; Back to all organizations</a></p>
        <% } else { %>
            <h1>
                <%= organizationDetails.name %>
            </h1>

            <img class="card__logo" src="/images/<%= organizationDetails.logo_filename %>"
                alt="<%= organizationDetails.name %> logo" style="margin-bottom: 1rem;">

            <p class="page-intro">
                <%= organizationDetails.description %>
            </p>
            <p><a href="mailto:<%= organizationDetails.contact_email %>">
                    <%= organizationDetails.contact_email %>
                </a></p>

            <% if (user && user.role_name==='admin' ) { %>
                <a href="/edit-organization/<%= organizationDetails.organization_id %>" class="button">Edit
                    Organization</a>
                <% } %>

                    <h2>Service Projects</h2>

                    <% if (projects.length===0) { %>
                        <p>No service projects are currently listed for this organization.</p>
                        <% } else { %>
                            <ul class="panel-list">
                                <% projects.forEach(project=> { %>
                                    <li class="panel-list__item">
                                        <a href="/project/<%= project.project_id %>"><strong>
                                                <%= project.title %>
                                            </strong></a>
                                    </li>
                                    <% }); %>
                            </ul>
                            <% } %>
                                <% } %>

<%- include('partials/footer') %>